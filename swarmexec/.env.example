# ── Mode ──────────────────────────────────────────────────────────────────
# PAPER (default) | TESTNET | LIVE_CAPPED | LIVE
# Leave unset (or PAPER) for normal development. See README.md before
# ever setting this to LIVE_CAPPED or LIVE.
SWARMEXEC_MODE=PAPER

# Required only to boot in unrestricted LIVE mode. Must match exactly.
# SWARMEXEC_CONFIRM=I ACCEPT REAL FINANCIAL LOSS

# ── Data / control ───────────────────────────────────────────────────────
SWARMEXEC_DATA_DIR=./data
SWARMEXEC_KILLSWITCH_PATH=./data/KILL
SWARMEXEC_POLL_INTERVAL_MS=15000

# ── Solana RPC ───────────────────────────────────────────────────────────
# Public mainnet RPC is rate-limited and not private (MEV exposure). Use a
# private/paid RPC (Helius, Triton, QuickNode, ...) for LIVE_CAPPED/LIVE.
SWARMEXEC_RPC_URL=https://api.mainnet-beta.solana.com

# ── Signer service (only needed for LIVE_CAPPED / LIVE) ─────────────────
# Run `npm run signer` as its OWN process, with its OWN env, ideally on
# its own OS user or container. Never put the keypair path or token in the
# same env as the main trading loop process in a real deployment.
SWARMEXEC_SIGNER_URL=http://127.0.0.1:8787
SWARMEXEC_SIGNER_PORT=8787
# Path to a Solana CLI-format keypair JSON file (a burner wallet — fund it
# only with what you are fully prepared to lose).
# SWARMEXEC_SIGNER_KEYPAIR_PATH=/absolute/secure/path/to/burner-keypair.json
# Shared secret the main process must present to the signer over localhost.
# SWARMEXEC_SIGNER_TOKEN=generate-a-long-random-value-here

# The signer refuses to guess this — it has changed across major Jupiter
# versions (v4 -> v6) and a stale/wrong value is exactly the kind of
# mistake the allowlist exists to catch. Read the current value yourself
# from https://docs.jup.ag before setting it.
# SWARMEXEC_JUPITER_PROGRAM_ID=
